# How to use this script file:
# Replace |> with %>% if don't have the pipe operator applied
# ggsave() allows you to save the figure to whereever you need it
# If you run the line as is it will save to your current working directory
# Check working directory:
getwd()
# Load required libraries:
library(readr)
library(ggplot2)
library(tidyverse)
# Specify column names:
col_names = c('Time', 'G_aestuaria', 'A_breviceps')
#-------------------------------------------------------------------------------
# Read in summer data:
summer = read_csv2('Gut evacuation.csv',
skip = 3,
n_max = 32,
col_names = col_names
)
# Summarise data for plotting:
summer_summary = summer |>
pivot_longer(
cols = c(G_aestuaria, A_breviceps), # This line!!
names_to = 'Species',
values_to = 'Gut_fullness'
) |>
group_by(Time,Species) |>
summarise(
mean_fullness = mean(Gut_fullness,na.rm=TRUE),
sd_fullness   = sd(Gut_fullness,na.rm=TRUE),
n             = n(),
se_fullness   = sd_fullness/sqrt(n),
.groups='drop'
)
# Plot summer:
summer_plot = ggplot(data=summer_summary,
mapping=aes(x=Time,
y=mean_fullness,
colour=Species,
group=Species))+
geom_line(linewidth=1)+
geom_point(size=2.5)+
geom_errorbar(
aes(ymin = mean_fullness-se_fullness,
ymax = mean_fullness+se_fullness),
width=0.04)+
scale_color_manual(
values = c("G_aestuaria" = "deeppink", "A_breviceps" = "steelblue3"),
labels = c("Gilchristella aesturia", "Atherina breviceps")
) +
labs(
title='insert some title here',
x='insert x axis title here',
y='insert y axis title here',
colour='Species',
)+
theme_minimal(base_size=14)
summer_plot
