# ==========================================
# 1. Load Required Libraries
# ==========================================
if (!require("ggplot2")) install.packages("ggplot2")
library(ggplot2)
# ==========================================
# 2. Define Beta Prior Function & Grid
# ==========================================
# Generate sequence across [0, 1]
x_grid = seq(0.0001, 0.9999, length.out = 1000)
# Helper function to construct Beta density data frame
get_beta_density = function(alpha, beta_param, label) {
data.frame(
x = x_grid,
y = dbeta(x_grid, shape1 = alpha, shape2 = beta_param),
Prior = label
)
}
# ==========================================
# 3. Define Beta Prior Shapes
# ==========================================
df_beta = rbind(
get_beta_density(alpha = 1,   beta_param = 1,   label = "1. Flat / Uninformative: Beta(1, 1)"),
get_beta_density(alpha = 2,   beta_param = 5,   label = "2. Right-Skewed (Low Mean): Beta(2, 5)"),
get_beta_density(alpha = 5,   beta_param = 2,   label = "3. Left-Skewed (High Mean): Beta(5, 2)"),
get_beta_density(alpha = 10,  beta_param = 10,  label = "4. Symmetric Unimodal: Beta(10, 10)"),
get_beta_density(alpha = 50,  beta_param = 150, label = "5. High Precision (Sparse Mean = 0.25): Beta(50, 150)"),
get_beta_density(alpha = 0.5, beta_param = 0.5, label = "6. U-Shaped / Bimodal Edge: Beta(0.5, 0.5)")
)
df_beta$Prior = factor(
df_beta$Prior,
levels = c(
"1. Flat / Uninformative: Beta(1, 1)",
"2. Right-Skewed (Low Mean): Beta(2, 5)",
"3. Left-Skewed (High Mean): Beta(5, 2)",
"4. Symmetric Unimodal: Beta(10, 10)",
"5. High Precision (Sparse Mean = 0.25): Beta(50, 150)",
"6. U-Shaped / Bimodal Edge: Beta(0.5, 0.5)"
)
)
# ==========================================
# 4. ggplot2 Faceted Comparison Across [0, 1]
# ==========================================
p_beta = ggplot(df_beta, aes(x = x, y = y, fill = Prior)) +
geom_area(alpha = 0.6, color = "black", linewidth = 0.3) +
facet_wrap(~ Prior, scales = "free_y", ncol = 3) +
scale_x_continuous(limits = c(0, 1), breaks = c(0, 0.25, 0.5, 0.75, 1)) +
scale_fill_manual(values = c(
"1. Flat / Uninformative: Beta(1, 1)"                 = "gray40",
"2. Right-Skewed (Low Mean): Beta(2, 5)"               = "firebrick",
"3. Left-Skewed (High Mean): Beta(5, 2)"               = "forestgreen",
"4. Symmetric Unimodal: Beta(10, 10)"                  = "navy",
"5. High Precision (Sparse Mean = 0.25): Beta(50, 150)" = "purple",
"6. U-Shaped / Bimodal Edge: Beta(0.5, 0.5)"           = "darkorange"
)) +
theme_minimal(base_size = 12) +
labs(
title = "Beta Prior Density Distributions Across [0, 1]",
subtitle = "Analytical Beta(a, b) curves across varying shape & precision parameterizations",
x = "Probability / Proportion (p)",
y = "Prior Probability Density f(p)"
) +
theme(
legend.position = "none",
strip.text = element_text(face = "bold", size = 9),
panel.grid.minor = element_blank(),
plot.title = element_text(face = "bold")
)
print(p_beta)
# ==========================================
# 1. Load Required Libraries
# ==========================================
if (!require("ggplot2")) install.packages("ggplot2")
library(ggplot2)
# ==========================================
# 2. Define MIMOSA2 Alternative Prior Sampler
# ==========================================
# MIMOSA2 parameterizes Beta via mean (mu) and precision (phi)
rmimosa2_alt_prior = function(n = 50000,
mu_u = 0.002,  # Baseline mean (e.g. 0.2%)
mu_s = 0.020,  # Alternative stimulated mean (e.g. 2.0%)
phi_u = 500,   # Baseline precision
phi_s = 300) { # Stimulated precision
# Reparameterization to Beta alpha & beta
alpha_u = mu_u * phi_u
beta_u  = (1 - mu_u) * phi_u
alpha_s = mu_s * phi_s
beta_s  = (1 - mu_s) * phi_s
# Sample proportions from Beta distributions
p_u = rbeta(n, shape1 = alpha_u, shape2 = beta_u)
p_s = rbeta(n, shape1 = alpha_s, shape2 = beta_s)
data.frame(
p_u = p_u,
p_s = p_s,
diff = p_s - p_u,
alpha_u = alpha_u, beta_u = beta_u,
alpha_s = alpha_s, beta_s = beta_s
)
}
# ==========================================
# 3. Simulate Samples
# ==========================================
set.seed(123)
N = 50000
# Draw from MIMOSA2 alternative prior specification
alt_draws = rmimosa2_alt_prior(
n = N,
mu_u = 0.05,  # Scaled for visual clarity across [0, 1]
mu_s = 0.35,
phi_u = 40,
phi_s = 25
)
df = data.frame(
Value = c(
alt_draws$p_u,
alt_draws$p_s,
alt_draws$diff,
dbeta(seq(0.001, 0.999, length.out = N), alt_draws$alpha_u[1], alt_draws$beta_u[1]),
dbeta(seq(0.001, 0.999, length.out = N), alt_draws$alpha_s[1], alt_draws$beta_s[1]),
alt_draws$p_s / alt_draws$p_u
),
Prior = factor(
rep(c(
"1. Unstimulated p_u ~ Beta(a_u, b_u)",
"2. Alternative p_s ~ Beta(a_s, b_s)",
"3. Effect Size: p_s - p_u",
"4. Analytical Baseline Density",
"5. Analytical Alt Response Density",
"6. Fold-Change Ratio: p_s / p_u"
), each = N),
levels = c(
"1. Unstimulated p_u ~ Beta(a_u, b_u)",
"2. Alternative p_s ~ Beta(a_s, b_s)",
"3. Effect Size: p_s - p_u",
"4. Analytical Baseline Density",
"5. Analytical Alt Response Density",
"6. Fold-Change Ratio: p_s / p_u"
)
)
)
# ==========================================
# 4. ggplot2 Faceted Comparison Across [0, 1]
# ==========================================
p_faceted = ggplot(df, aes(x = Value, fill = Prior)) +
geom_density(alpha = 0.6, color = "black", linewidth = 0.3) +
facet_wrap(~ Prior, scales = "free_y", ncol = 3) +
scale_x_continuous(limits = c(0, 1), breaks = c(0, 0.25, 0.5, 0.75, 1)) +
scale_fill_manual(values = c(
"1. Unstimulated p_u ~ Beta(a_u, b_u)" = "navy",
"2. Alternative p_s ~ Beta(a_s, b_s)" = "forestgreen",
"3. Effect Size: p_s - p_u"           = "purple",
"4. Analytical Baseline Density"       = "royalblue",
"5. Analytical Alt Response Density"   = "darkgreen",
"6. Fold-Change Ratio: p_s / p_u"      = "orange"
)) +
theme_minimal(base_size = 12) +
labs(
title = "MIMOSA2 Alternative Prior Specification (Beta Reparameterization)",
subtitle = paste0("Beta(a = mu*phi, b = (1-mu)*phi) under H1 alternative response component"),
x = "Probability / Proportion (p)",
y = "Prior Density"
) +
theme(
legend.position = "none",
strip.text = element_text(face = "bold", size = 9),
panel.grid.minor = element_blank(),
plot.title = element_text(face = "bold")
)
print(p_faceted)
