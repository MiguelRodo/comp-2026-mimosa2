AUROC <- ROC_data_prepared %>%
group_by(Res_prop, P, Cell_range, Effect, Method) %>%
filter(length(unique(Truth)) == 2) %>%
do(plotROC::calc_auc(
ggplot(., aes(d = Truth, m = Score)) + geom_roc()
)) %>%
ungroup() %>%
rename(AUROC = AUC)
