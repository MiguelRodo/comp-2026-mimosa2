prior_antigen_toxicity = function(n = 100000,
base_mean = 0.002,
base_phi = 500,
suppression_factor = 0.6) {
# Unstimulated background baseline
p_u = rbeta(n, base_mean * base_phi, (1 - base_mean) * base_phi)
# Stimulated rate is actively suppressed below background due to cell death (p_s < p_u)
p_s = p_u * (1 - rbeta(n, suppression_factor * 5, (1 - suppression_factor) * 5))
data.frame(p_u = p_u, p_s = p_s, scenario = "Antigen Toxicity")
}
# ==============================================================================
# 3. Generate Data
# ==============================================================================
set.seed(42)
df_scen1 = prior_antigen_toxicity(n = 100000)
# ==============================================================================
# 4. Plot 1: 2D Joint Density (p_s vs p_u)
# ==============================================================================
p1 = ggplot(df_scen1, aes(x = p_u, y = p_s)) +
geom_bin2d(bins = 100) +
scale_fill_viridis_c(option = "magma") +
# MIMOSA2 Monotonicity Boundary (p_s = p_u)
geom_abline(intercept = 0, slope = 1, color = "cyan", linetype = "dashed", linewidth = 1) +
annotate("text", x = 0.0032, y = 0.0036, label = "MIMOSA2 Boundary Line (p_s = p_u)",
color = "cyan", fontface = "bold", angle = 32) +
scale_x_continuous(labels = scales::percent_format(accuracy = 0.1)) +
scale_y_continuous(labels = scales::percent_format(accuracy = 0.1)) +
coord_cartesian(xlim = c(0, 0.006), ylim = c(0, 0.006)) + # Visual zoom without dropping data
theme_minimal(base_size = 12) +
labs(
title = "Scenario 1: Joint Distribution of p_s vs p_u",
subtitle = "100% of samples sit in the paradoxical region below the cyan line (p_s < p_u)",
x = "Unstimulated Background Proportion (p_u)",
y = "Stimulated Proportion (p_s)",
fill = "Density"
) +
theme(
plot.title = element_text(face = "bold"),
legend.position = "right"
)
# ==============================================================================
# 5. Plot 2: Marginal Density Comparison (p_u vs p_s)
# ==============================================================================
df_long = pivot_longer(df_scen1, cols = c("p_u", "p_s"), names_to = "Channel", values_to = "Proportion")
df_long$Channel = factor(df_long$Channel, levels = c("p_u", "p_s"),
labels = c("Unstimulated (p_u)", "Stimulated (p_s)"))
p2 = ggplot(df_long, aes(x = Proportion, fill = Channel, color = Channel)) +
geom_density(alpha = 0.4, linewidth = 0.8) +
scale_fill_manual(values = c("Unstimulated (p_u)" = "navy", "Stimulated (p_s)" = "firebrick")) +
scale_color_manual(values = c("Unstimulated (p_u)" = "navy", "Stimulated (p_s)" = "firebrick")) +
scale_x_continuous(labels = scales::percent_format(accuracy = 0.1)) +
coord_cartesian(xlim = c(0, 0.006)) +
theme_minimal(base_size = 12) +
labs(
title = "Marginal Distributions: Systematic Downward Shift",
subtitle = "Cell death causes stimulated proportions (red) to contract below control baseline (blue)",
x = "Cell Proportion",
y = "Prior Density",
fill = "Channel",
color = "Channel"
) +
theme(
plot.title = element_text(face = "bold"),
legend.position = "top"
)
# Combine plots vertically
p1 / p2
# ==========================================
# 1. Load Required Libraries
# ==========================================
if (!require("ggplot2")) install.packages("ggplot2")
library(ggplot2)
# --- Standard Bounded Priors ---
rlogitnorm = function(n, target_mean, phi) {
sdlogit   = 1 / sqrt(phi)
meanlogit = qlogis(target_mean)
plogis(rnorm(n, mean = meanlogit, sd = sdlogit))
}
rgamma_exp = function(n, target_mean, gamma_dispersion) {
gamma_mean = gamma_dispersion * (target_mean^(-1 / gamma_dispersion) - 1)
exp(-rgamma(n, shape = gamma_dispersion, rate = gamma_dispersion / gamma_mean))
}
rsimplex = function(n, target_mean, phi) {
mu_ig     = target_mean / (1 - target_mean)
lambda_ig = phi * (target_mean^2) * ((1 - target_mean)^2)
v         = rnorm(n)^2
x         = mu_ig + (mu_ig^2 * v) / (2 * lambda_ig) -
(mu_ig / (2 * lambda_ig)) * sqrt(4 * mu_ig * lambda_ig * v + mu_ig^2 * v^2)
z         = runif(n)
indices   = z > (mu_ig / (mu_ig + x))
x[indices] = (mu_ig^2) / x[indices]
return(x / (1 + x))
}
# --- Wonky Priors ---
rlogit_cauchy = function(n, target_mean, phi) {
scale_param = 1 / sqrt(phi)
location    = qlogis(target_mean)
plogis(rcauchy(n, location = location, scale = scale_param))
}
rbimodal_spike = function(n, target_mean, separation = 0.15, concentration = 50) {
mu_low  = pmax(0.01, pmin(0.99, target_mean - separation))
mu_high = pmax(0.01, pmin(0.99, target_mean + separation))
assign  = rbinom(n, 1, 0.5)
lows    = rbeta(n, mu_low * concentration, (1 - mu_low) * concentration)
highs   = rbeta(n, mu_high * concentration, (1 - mu_high) * concentration)
ifelse(assign == 0, lows, highs)
}
rstep_gap = function(n, target_mean, gap_width = 0.10) {
low_bound  = pmax(0.001, target_mean - gap_width)
high_bound = pmin(0.999, target_mean + gap_width)
assign     = rbinom(n, 1, 0.5)
lows       = runif(n, min = 0.001, max = low_bound)
highs      = runif(n, min = high_bound, max = 0.999)
ifelse(assign == 0, lows, highs)
}
# ==========================================
# 3. Simulate Samples
# ==========================================
set.seed(123)
N           = 50000
target_mean = 0.25
phi         = 500
df = data.frame(
Value = c(
rlogitnorm(N, target_mean, phi),
rsimplex(N, target_mean, phi),
rgamma_exp(N, target_mean, phi),
rlogit_cauchy(N, target_mean, phi),
rbimodal_spike(N, target_mean, separation = 0.15, concentration = 50),
rstep_gap(N, target_mean, gap_width = 0.10)
),
Prior = factor(
rep(c("Standard: Logit-Normal",
"Standard: Simplex",
"Standard: Exponential Gamma",
"Wonky 1: Logit-Cauchy",
"Wonky 2: Bimodal Spike",
"Wonky 3: Step Gap"), each = N),
levels = c("Standard: Logit-Normal",
"Standard: Simplex",
"Standard: Exponential Gamma",
"Wonky 1: Logit-Cauchy",
"Wonky 2: Bimodal Spike",
"Wonky 3: Step Gap")
)
)
# ==========================================
# 4. ggplot2 Faceted Comparison
# ==========================================
p_faceted = ggplot(df, aes(x = Value, fill = Prior)) +
geom_density(alpha = 0.6, color = "black", linewidth = 0.3) +
facet_wrap(~ Prior, scales = "free_y", ncol = 3) +
scale_x_continuous(limits = c(0, 1), breaks = c(0, 0.25, 0.5, 0.75, 1)) +
theme_minimal(base_size = 12) +
labs(
title = "MIMOSA2 Prior Comparison: Standard vs. 'Wonky' Stress-Tests",
subtitle = paste0("Target mean = ", target_mean, ", Precision parameter = ", phi, " (N = ", N, " draws)"),
x = "Probability / Proportion (p)",
y = "Prior Density"
) +
theme(
legend.position = "none",
strip.text = element_text(face = "bold"),
panel.grid.minor = element_blank()
)
print(p_faceted)
# ==========================================
# 1. Load Required Libraries
# ==========================================
if (!require("ggplot2")) install.packages("ggplot2")
library(ggplot2)
# 1. Base Unstimulated Control (p_u)
rbase_pu = function(n, mean = 0.002, phi = 500) {
rbeta(n, mean * phi, (1 - mean) * phi)
}
# 2. Standard Expected Responder (p_s >= p_u)
rstandard_responder = function(n, mean_s = 0.006, phi = 500) {
rbeta(n, mean_s * phi, (1 - mean_s) * phi)
}
# 3-6. Scenario 1 Toxicity Variations (p_s < p_u due to cell death)
rantigen_toxicity = function(n, base_mean = 0.002, base_phi = 500, suppression_level = 0.3) {
p_u = rbeta(n, base_mean * base_phi, (1 - base_mean) * base_phi)
# Suppression factor contracts p_s strictly below p_u
p_s = p_u * (1 - rbeta(n, suppression_level * 10, (1 - suppression_level) * 10))
return(p_s)
}
# ==========================================
# 3. Simulate Samples
# ==========================================
set.seed(123)
N         = 50000
base_mean = 0.002
phi       = 500
df = data.frame(
Value = c(
rbase_pu(N, mean = base_mean, phi = phi),
rstandard_responder(N, mean_s = 0.006, phi = phi),
rantigen_toxicity(N, base_mean = base_mean, base_phi = phi, suppression_level = 0.20),
rantigen_toxicity(N, base_mean = base_mean, base_phi = phi, suppression_level = 0.45),
rantigen_toxicity(N, base_mean = base_mean, base_phi = phi, suppression_level = 0.70),
rantigen_toxicity(N, base_mean = base_mean, base_phi = phi, suppression_level = 0.90)
),
Prior = factor(
rep(c(
"1. Unstimulated Control (p_u)",
"2. Standard Responder (p_s >= p_u)",
"3. Mild Toxicity (20% Drop)",
"4. Moderate Prozone (45% Drop)",
"5. Severe Toxicity (70% Drop)",
"6. Extreme Collapse (90% Drop)"
), each = N),
levels = c(
"1. Unstimulated Control (p_u)",
"2. Standard Responder (p_s >= p_u)",
"3. Mild Toxicity (20% Drop)",
"4. Moderate Prozone (45% Drop)",
"5. Severe Toxicity (70% Drop)",
"6. Extreme Collapse (90% Drop)"
)
)
)
# ==========================================
# 4. ggplot2 Faceted Comparison
# ==========================================
p_faceted = ggplot(df, aes(x = Value, fill = Prior)) +
geom_density(alpha = 0.6, color = "black", linewidth = 0.3) +
facet_wrap(~ Prior, scales = "free_y", ncol = 3) +
scale_x_continuous(
labels = scales::percent_format(accuracy = 0.1),
breaks = seq(0, 0.008, by = 0.002)
) +
coord_cartesian(xlim = c(0, 0.008)) +
scale_fill_manual(values = c(
"1. Unstimulated Control (p_u)"       = "navy",
"2. Standard Responder (p_s >= p_u)"  = "forestgreen",
"3. Mild Toxicity (20% Drop)"         = "orange",
"4. Moderate Prozone (45% Drop)"      = "darkorange",
"5. Severe Toxicity (70% Drop)"       = "firebrick",
"6. Extreme Collapse (90% Drop)"     = "darkred"
)) +
theme_minimal(base_size = 12) +
labs(
title = "Scenario 1: Antigen Toxicity & Prozone Spectrum (p_s < p_u)",
subtitle = paste0("Cell density contraction across suppression levels (N = ", format(N, big.mark = ","), " draws)"),
x = "Cell Proportion (p)",
y = "Prior Density"
) +
theme(
legend.position = "none",
strip.text = element_text(face = "bold", size = 10),
panel.grid.minor = element_blank(),
plot.title = element_text(face = "bold")
)
print(p_faceted)
# ==========================================
# 1. Load Required Libraries
# ==========================================
if (!require("ggplot2")) install.packages("ggplot2")
library(ggplot2)
# ==========================================
# 2. Define Prior Sampler (p_u > p_s)
# ==========================================
rprior_pu_gt_ps = function(n = 50000, mean_pu = 0.60, phi_pu = 20, a_ratio = 2, b_ratio = 2) {
alpha_u = mean_pu * phi_pu
beta_u  = (1 - mean_pu) * phi_pu
p_u     = rbeta(n, alpha_u, beta_u)
# Relative ratio r in (0, 1) guarantees p_s < p_u
r       = rbeta(n, a_ratio, b_ratio)
p_s     = p_u * r
data.frame(
p_u   = p_u,
p_s   = p_s,
diff  = p_u - p_s,
ratio = r
)
}
# ==========================================
# 3. Simulate Samples Across [0, 1]
# ==========================================
set.seed(123)
N = 50000
# Draw baseline scenario (mean p_u = 0.60)
base_draws = rprior_pu_gt_ps(N, mean_pu = 0.60, phi_pu = 15, a_ratio = 2, b_ratio = 2)
# Draw extreme suppression scenario (mean p_u = 0.85, severe drop)
severe_draws = rprior_pu_gt_ps(N, mean_pu = 0.85, phi_pu = 20, a_ratio = 1, b_ratio = 5)
df = data.frame(
Value = c(
base_draws$p_u,
base_draws$p_s,
base_draws$diff,
base_draws$ratio,
severe_draws$p_u,
severe_draws$p_s
),
Prior = factor(
rep(c(
"1. Baseline Unstimulated: p_u",
"2. Stimulated: p_s (p_u > p_s)",
"3. Absolute Shift: p_u - p_s",
"4. Relative Ratio: r = p_s / p_u",
"5. High Baseline: p_u (Mean = 0.85)",
"6. Severe Suppression: p_s"
), each = N),
levels = c(
"1. Baseline Unstimulated: p_u",
"2. Stimulated: p_s (p_u > p_s)",
"3. Absolute Shift: p_u - p_s",
"4. Relative Ratio: r = p_s / p_u",
"5. High Baseline: p_u (Mean = 0.85)",
"6. Severe Suppression: p_s"
)
)
)
# ==========================================
# 4. ggplot2 Faceted Comparison Across [0, 1]
# ==========================================
p_faceted = ggplot(df, aes(x = Value, fill = Prior)) +
geom_density(alpha = 0.6, color = "black", linewidth = 0.3) +
facet_wrap(~ Prior, scales = "free_y", ncol = 3) +
scale_x_continuous(limits = c(0, 1), breaks = c(0, 0.25, 0.5, 0.75, 1)) +
scale_fill_manual(values = c(
"1. Baseline Unstimulated: p_u"       = "navy",
"2. Stimulated: p_s (p_u > p_s)"     = "firebrick",
"3. Absolute Shift: p_u - p_s"       = "purple",
"4. Relative Ratio: r = p_s / p_u"   = "darkgreen",
"5. High Baseline: p_u (Mean = 0.85)" = "royalblue",
"6. Severe Suppression: p_s"          = "darkred"
)) +
theme_minimal(base_size = 12) +
labs(
title = "Prior Distribution for p_u > p_s Across [0, 1]",
subtitle = paste0("Simulated draws showing baseline p_u, suppressed p_s, and difference terms (N = ", format(N, big.mark = ","), ")"),
x = "Probability / Proportion (p)",
y = "Prior Density"
) +
theme(
legend.position = "none",
strip.text = element_text(face = "bold"),
panel.grid.minor = element_blank(),
plot.title = element_text(face = "bold")
)
print(p_faceted)
