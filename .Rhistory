# Chunk 2
n<-1000
y<-25
prior<-function(theta,a,b){ dbeta(theta, a, b) }
posterior<-function(theta,a,b)
{
#ignoring predictive distribution
prior(theta,a,b) * dbinom(y, size=n, prob=theta)
}
xtheta<-seq(from=0.0001, to=0.15, length.out=500) #some range for theta
# Chunk 3
pr.post.plot<-function(theta,a,b)
{
#A function to plot the prior and posterior rescaled such that max=1
prior_p<-prior(theta,a=a,b=b)
post_p<-sapply(theta, posterior, a=a, b=b)
plot(theta, post_p/max(post_p) , type="l", col="red", ylab="",
xlab=expression(theta))
legend("topright",
c("Prior",paste("(a=",a,",b=",b,")",sep=""), "", "Posterior"),
lty=c(2,NA, NA, 1), col=c("black", NA, NA, "red"), bty="n", cex=.7)
lines(theta, prior_p/max(prior_p) , col="black", lty=2)
}
# Chunk 4: plot_beta_binom
par(mfrow=c(2,2), mar=c(4,4,1,2))
pr.post.plot(xtheta,a=1,b=1)
pr.post.plot(xtheta,a=0.5,b=20)
pr.post.plot(xtheta,a=50,b=5000)
pr.post.plot(xtheta,a=300,b=5000)
