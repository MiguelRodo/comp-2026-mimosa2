for (i in 1:B) {
idx = sample(1:n,n,replace=TRUE)
bts.smpl = dat[idx,]
bts.xsum = 0
bts.ysum = 0
for (k in 1:n) {
if (bts.smpl$SexF[k]==1) {
bts.xsum = bts.xsum + as.numeric(bts.smpl$Weight[k])
} else {
bts.ysum = bts.ysum + as.numeric(bts.smpl$Weight[k])
}
}
bts.xbar = bts.xsum/(sum(bts.smpl$SexF))
bts.ybar = bts.ysum/(sum(bts.smpl$SexM))
tboot[i] = bts.xbar/bts.ybar
}
bts.mean = mean(tboot)
bts.bias = bts.mean - tobs
bts.se   = sqrt((1/(B-1))*sum((tboot-bts.mean)^2))
bts.mean
bts.bias
bts.se
