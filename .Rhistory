library(plotly)
# Parameters:
n0 = c(35)   # no. coin tosses
n  = c(1:n0) # genewrate coin tosses
w0 = c(1e9)  # finite game ceiling wealth
p  = c(0.5)  # probability of head
# Calculate:
pay1 = cumsum((p^n)*(2^n))       # gamble payoff
pay2 = cumsum((p^n)*min(2^n,w0)) # finite gamble payoff
u1 = (p^n)*log(2^n) # utility of hamble
u2 = (p^n)*log(min(2^n,w0)) # utility of finite gamble
eu1 = cumsum(u1) # expected utility of gamble
eu2 = cumsum(u2) # expected utility of finite gamble
ce2 = exp(eu2) # certainity equivalent
# Plot:
p1 = plot_ly(data.frame(n,pay2),x=~n,y=~pay2,type='scatter',mode='lines')
p2 = plot_ly(data.frame(n,u2),x=~n,y=~u2,type='scatter',mode='lines')
p3 = plot_ly(data.frame(n,eu2),x=~n,y=~eu2,type='scatter',mode='lines')
p4 = plot_ly(data.frame(n,ce2),x=~n,y=~ce2,type='scatter',mode='lines')
p0 = subplot(p1,p2,p3,p4,nrows=2)
p0
