# Use bootstrapping to estimate bias:
dat = as.data.frame(cbind(Tortoise_data$Sex,Tortoise_data$Weight))
colnames(dat) = c('Sex','Weight')
# View(dat)
dat$SexF = ifelse(dat$Sex=='F',1,0)
dat$SexM = ifelse(dat$Sex=='M',1,0)
dat = dat[,-1]
# Calculate mean weight of females (x) and males (y):
n = nrow(dat)
nF = sum(dat$SexF)
nM = sum(dat$SexM)
x_sum = 0
y_sum = 0
for (i in 1:n) {
if (dat$SexF[i]==1) {
x_sum = x_sum + as.numeric(dat$Weight[i])
} else {
y_sum = y_sum + as.numeric(dat$Weight[i])
}
}
x_bar = x_sum/nF
y_bar = y_sum/nM
# Bootstrapping:
B = 10000
tobs  = x_bar/y_bar
tboot = numeric(B)
for (i in 1:B) {
idx = sample(1:n,n,replace=TRUE)
bts.smpl = dat[idx,]
bts.xsum = 0
bts.ysum = 0
for (k in 1:n) {
if (bts.smpl$SexF[k]==1) {
bts.xsum = bts.xsum + as.numeric(bts.smpl$Weight[k])
} else {
bts.ysum = bts.ysum + as.numeric(bts.smpl$Weight[k])
}
}
bts.xbar = bts.xsum/(sum(bts.smpl$SexF))
bts.ybar = bts.ysum/(sum(bts.smpl$SexM))
tboot[i] = bts.xbar/bts.ybar
}
tboot
