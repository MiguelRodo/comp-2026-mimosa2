y_bar.c = mean(y)
# Calculate ratio:
ratio = x_bar.c/y_bar.c
boot_x = replicate(B,mean(x,size=nF,replace=TRUE))
boot_y = replicate(B,mean(y,size=nM,replace=TRUE))
boot_ratio = boot_x/boot_y
q_lower = quantile(boot_ratio,probs=0.025)
q_upper - quantile(boot_ratio,probs=0.975)
ci_lower = 2*ratio-q_upper
ci_upper = 2*ratio-q_lower
if (ci_lower<=true_mean&&true_mean<=ci_upper) {
count=count+1
}
}
N = 1000
B = 1000
nF = nF
nM = nM
xtrue_mean = 0.9*0.7
ytrue_mean = 1.1*0.7
true_mean  = xtrue_mean/ytrue_mean
count = 0
for (i in 1:N) {
# Sample for x:
x = rgamma(nF,shape=0.9,scale=0.7)
x_bar.c = mean(x)
# Sample for y:
y = rgamma(nM,shape=1.1,scale=0.7)
y_bar.c = mean(y)
# Calculate ratio:
ratio = x_bar.c/y_bar.c
boot_x = replicate(B,mean(sample(x,size=nF,replace=TRUE)))
boot_y = replicate(B,mean(sample(y,size=nM,replace=TRUE)))
boot_ratio = boot_x/boot_y
q_lower = quantile(boot_ratio,probs=0.025)
q_upper = quantile(boot_ratio,probs=0.975)
ci_lower = 2*ratio-q_upper
ci_upper = 2*ratio-q_lower
if (ci_lower<=true_mean&&true_mean<=ci_upper) {
count=count+1
}
}
